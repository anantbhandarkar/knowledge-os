# Knowledge OS configuration. Copy to .env and edit.

# Pipeline mode: "offline" (default — no keys, deterministic) or "api" (real LLMs).
KOS_MODE=offline

# LLM provider when KOS_MODE=api: "openrouter" (default) or "deepseek".
KOS_PROVIDER=openrouter
# Override the model (else a provider default is used):
#   openrouter -> nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   deepseek   -> deepseek-chat  (or deepseek-reasoner)
# KOS_MODEL=

# Vector store: "memory" (default), "pgvector", or "turbovec".
VECTOR_STORE=memory

# --- Only needed when KOS_MODE=api (set the one matching KOS_PROVIDER) ---
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Only needed when VECTOR_STORE=pgvector|turbovec ---
# DATABASE_URL=postgresql://kos:kos@postgres:5432/knowledge_os
