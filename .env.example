# Knowledge OS configuration. Copy to .env and edit.

# Pipeline mode: "offline" (default — no keys, deterministic) or "api" (real LLMs).
KOS_MODE=offline

# Vector store: "memory" (default), "pgvector", or "turbovec".
VECTOR_STORE=memory

# --- Only needed when KOS_MODE=api ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COHERE_API_KEY=
# GEMINI_API_KEY=

# --- Only needed when VECTOR_STORE=pgvector|turbovec ---
# DATABASE_URL=postgresql://kos:kos@postgres:5432/knowledge_os
